{
  "name": "vd-wedding-concierge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:preview": "tsc -b && vite build --config vite.preview.config.ts",
    "start": "node dist-server/index.js",
    "backup": "node scripts/backup.mjs",
    "restore:verify": "node scripts/restore-verify.mjs",
    "telegram:configure": "node scripts/configure-telegram.mjs",
    "examples:generate": "node scripts/generate-synthetic-conversations.mjs",
    "test:security": "node scripts/security-smoke.mjs",
    "test:load": "node scripts/load-smoke.mjs",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "latest",
    "multer": "^2.5.0",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.5",
    "typescript": "latest",
    "vite": "latest",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "latest"
  }
}
